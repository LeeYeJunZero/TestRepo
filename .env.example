# 서버 포트
PORT=3000
# production 으로 두면 Secure 쿠키 + ADMIN_PASSWORD 필수
NODE_ENV=production
# 가비아에서 구매한 도메인 (서브도메인 admin/math/english/coding 사용)
SITE_DOMAIN=example.com
# 어드민 로그인 비밀번호 (반드시 변경)
ADMIN_PASSWORD=change-me-strong-password
# 세션 서명 키 (openssl rand -hex 32 로 생성)
SESSION_SECRET=
# SQLite 파일 위치
DATA_DIR=./data
