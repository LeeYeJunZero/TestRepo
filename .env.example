# 서버 포트
PORT=3000
# production 으로 두면 Secure 쿠키 + ADMIN_PASSWORD 필수
NODE_ENV=production
# 가비아 도메인 (사이트: 도메인/www, 어드민: admin.도메인)
SITE_DOMAIN=firstteacher.co.kr
# 어드민 로그인 비밀번호 (반드시 변경)
ADMIN_PASSWORD=change-me-strong-password
# 세션 서명 키 (openssl rand -hex 32 로 생성)
SESSION_SECRET=
# SQLite 파일 위치
DATA_DIR=./data
# 텔레그램 봇 (@BotFather → /newbot 으로 발급). 설정 시 서버 시작과 함께 봇 실행
# 연결: 봇 채팅창에서  /pair <ADMIN_PASSWORD>
TELEGRAM_BOT_TOKEN=
